{
  "kind": "discovery#restDescription",
  "id": "docs:v1",
  "name": "docs",
  "version": "v1",
  "title": "Test fixture preview overlay",
  "schemas": {
    "Request": {
      "id": "Request",
      "type": "object",
      "properties": {
        "acceptSuggestion": {
          "$ref": "AcceptSuggestionRequest",
          "description": "Accepts a suggestion. (Developer Preview)"
        }
      }
    },
    "AcceptSuggestionRequest": {
      "id": "AcceptSuggestionRequest",
      "type": "object",
      "description": "Accepts a suggestion. Returns a 403 forbidden error if the requesting user does not have edit access to the document.",
      "properties": {
        "suggestionId": {
          "type": "string",
          "description": "The ID of the suggestion."
        }
      }
    },
    "WriteControl": {
      "id": "WriteControl",
      "type": "object",
      "properties": {
        "writeMode": {
          "type": "string",
          "description": "How the request updates should be applied to the document.",
          "enum": [
            "WRITE_MODE_UNSPECIFIED",
            "EDIT",
            "SUGGEST"
          ]
        }
      }
    }
  }
}
